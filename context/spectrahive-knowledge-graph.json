      "id": "spectrahive",
      "type": "project",
      "label": "SpectraHive (SPHEREx Tracker)",
      "properties": {
        "description": "Plataforma web de ciencia ciudadana para descubrir cambios o anomalías en objetos infrarrojos mediante datos de SPHEREx.",
        "challenge": "Planet X and SPHEREx"
      }
