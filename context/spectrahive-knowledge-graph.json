        "purpose": "Revisa cuadrantes, identifica posibles cambios y contribuye con reportes."
      }
    },
    {
      "id": "core-workflow",
      "type": "workflow",
      "label": "Flujo central de análisis",
      "properties": {
        "steps": [
          "buscar por RA/Dec",
          "alternar entre Época A y B",
          "inspeccionar la resta absoluta |B-A|",
          "reportar anomalía o marcar limpio",
          "validar cruzadamente el reporte"
        ]
      }
    },
    {
      "id": "quadrant",
      "type": "data_entity",
      "label": "Cuadrante",
      "properties": {
        "table": "cuadrantes",
        "coordinates": "RA/Dec J2000",
        "allowed_fov": [
          1,
          2
        ],
        "states": [
          "pendiente",
          "confirmado",
          "descartado"
        ]
      }
    },
    {
      "id": "fixed-queue",
      "type": "workflow",
      "label": "Cola fija de cuadrantes",
      "properties": {
        "size": 10,
        "composition": "5 cuadrantes de prueba y 5 cuadrantes de práctica elegidos por el equipo",
        "random_or_unbounded": false
      }
    },
    {
      "id": "report",
      "type": "data_entity",
      "label": "Reporte",
      "properties": {
        "table": "reportes",
        "fields": [
          "cuadrante_id",
          "ra",
