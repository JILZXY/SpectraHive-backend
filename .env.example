# Modo local / pruebas (apunta al servicio db-local de docker-compose.yml)
DATABASE_URL=postgresql://spectrahive:spectrahive_local_dev@db-local:5432/spectrahive
# En produccion (Render): usar la cadena del pooler Supavisor (puerto 6543) de Supabase

# Variables informativas de Supabase (sin valores reales en el repo)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origenes permitidos para CORS (separados por coma; en produccion: URL de Vercel)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Directorio de datos precalculados
DATA_DIR=data
